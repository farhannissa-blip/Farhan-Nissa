            if (s === "" || s.toLowerCase() === "undefined" || s.toLowerCase() === "null") {
                return "Pemain Bintang";
            }
            return s;
        };

        window.sanitizeSekolah = function(sekolah) {
            if (!sekolah) return "SDN 66 Banda Aceh";
            const s = String(sekolah).trim();
            if (s === "" || s.toLowerCase() === "undefined" || s.toLowerCase() === "null") {
                return "SDN 66 Banda Aceh";
            }
            return s;
        };

        window.sanitizeKelas = function(kelas) {
            if (!kelas) return "-";
            const s = String(kelas).trim();
            if (s === "" || s.toLowerCase() === "undefined" || s.toLowerCase() === "null") {
                return "-";
            }
            return s;
        };

        window.filterUniqueDeviceScores = function(list) {
            if (!Array.isArray(list)) return [];
            const deviceMap = new Map();
            
            const validList = list.filter(item => item && typeof item === 'object' && item.skor !== undefined && item.skor !== null && !isNaN(Number(item.skor)));
            const sorted = validList.sort((a, b) => Number(b.skor) - Number(a.skor) || (a.waktu || 0) - (b.waktu || 0));
            
            sorted.forEach(item => {
                const cleanName = window.sanitizeName(item.nama);
                const cleanSekolah = window.sanitizeSekolah(item.sekolah);
                const cleanKelas = window.sanitizeKelas(item.kelas);
                
                item.nama = cleanName;
                item.sekolah = cleanSekolah;
                item.kelas = cleanKelas;

                const devId = item.device_id || (cleanName + '_' + cleanSekolah);
                if (!deviceMap.has(devId)) {
                    deviceMap.set(devId, item);
                }
            });
            return Array.from(deviceMap.values()).sort((a, b) => Number(b.skor) - Number(a.skor));
        };

