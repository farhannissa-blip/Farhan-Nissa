        function gameLoop(timestamp) {
            if (!isPlaying || isPaused) return;
            
            const deltaTime = Math.min((timestamp - lastTimestamp) / 1000, 0.1); 
            lastTimestamp = timestamp;

            // Update Timer
            timeRemaining -= deltaTime;
            const timerScale = Math.max(0, timeRemaining / maxTime);
            document.getElementById('timer-bar').style.transform = `scaleX(${timerScale})`;

            if (timeRemaining <= 0) { 
                handleMistake( pondArea.clientWidth / 2, pondArea.clientHeight / 2, "WAKTU HABIS!" ); 
                return; 
            }

            // Ambient Bubbles
            bubbleTimer += deltaTime;
            if (bubbleTimer > 0.65) {
                bubbleTimer = 0;
                spawnAmbientBubble();
            }

            const w = pondArea.clientWidth; 
            const h = pondArea.clientHeight;
            const margin = 52;

            fishEntities.forEach((fish, idx) => {
                if (fish.caught) return;

                // Soft organic wandering curve
                fish.wanderPhase += deltaTime * 2.2;
                const wanderForce = Math.sin(fish.wanderPhase) * 35;
                const perpX = -fish.vy / (fish.speed || 1);
                const perpY = fish.vx / (fish.speed || 1);
                fish.vx += perpX * wanderForce * deltaTime;
                fish.vy += perpY * wanderForce * deltaTime;

                // Soft steering away from pond borders
                const turnFactor = fish.speed * 4.2;
                if (fish.x < margin) fish.vx += turnFactor * deltaTime;
                else if (fish.x > w - 105 - margin) fish.vx -= turnFactor * deltaTime;
                
                if (fish.y < margin) fish.vy += turnFactor * deltaTime;
                else if (fish.y > h - 55 - margin) fish.vy -= turnFactor * deltaTime;

                // Soft fish-to-fish separation so numbers don't overlap
                for (let j = 0; j < fishEntities.length; j++) {
                    if (idx === j || fishEntities[j].caught) continue;
                    const other = fishEntities[j];
                    const dx = fish.x - other.x;
                    const dy = fish.y - other.y;
                    const distSq = dx * dx + dy * dy;
                    if (distSq < 6400 && distSq > 1) { // < 80px apart
                        const dist = Math.sqrt(distSq);
                        const push = (80 - dist) * 1.8;
                        fish.vx += (dx / dist) * push * deltaTime;
                        fish.vy += (dy / dist) * push * deltaTime;
                    }
                }

                // Normalize velocity to target speed
                const currentSpeed = Math.sqrt(fish.vx * fish.vx + fish.vy * fish.vy);
                if (currentSpeed > 0.01) {
                    fish.vx = (fish.vx / currentSpeed) * fish.speed;
                    fish.vy = (fish.vy / currentSpeed) * fish.speed;
                }

                fish.x += fish.vx * deltaTime; 
                fish.y += fish.vy * deltaTime;

                // Hard safety bounds
                if (fish.x < -15) { fish.x = -15; fish.vx = Math.abs(fish.vx); }
                if (fish.x > w - 85) { fish.x = w - 85; fish.vx = -Math.abs(fish.vx); }
                if (fish.y < -10) { fish.y = -10; fish.vy = Math.abs(fish.vy); }
                if (fish.y > h - 42) { fish.y = h - 42; fish.vy = -Math.abs(fish.vy); }

                // Occasional wake ripple behind fish tail
                fish.wakeTimer += deltaTime;
                if (fish.wakeTimer > 0.45 && !fish.isJumping) {
                    fish.wakeTimer = 0;
                    const wake = document.createElement('div');
                    wake.className = 'fish-wake';
                    wake.style.left = (fish.x + 48 - (fish.vx / fish.speed) * 32) + 'px';
                    wake.style.top = (fish.y + 23 - (fish.vy / fish.speed) * 32) + 'px';
                    effectsContainer.appendChild(wake);
                    setTimeout(() => wake.remove(), 900);
                }

                // Animasi Gerakan Tambahan: Ikan Melompat Keluar Air Secara Berkala
                fish.jumpCooldown -= deltaTime;
                if (fish.jumpCooldown <= 0 && !fish.isJumping) {
                    fish.isJumping = true;
                    fish.jumpTime = 0;
                    fish.jumpDuration = 0.68;
                    // Efek cipratan air saat ikan mulai melompat dari permukaan kolam
                    createWaterRipple(fish.x + 53, fish.y + 27);
                    createSplashDroplets(fish.x + 53, fish.y + 27, 5);
                    playFishJumpSound();
                }

                let jumpScale = 1;
                let jumpLiftY = 0;
                if (fish.isJumping) {
                    fish.jumpTime += deltaTime;
                    const jp = fish.jumpTime / fish.jumpDuration;
                    if (jp >= 1) {
                        fish.isJumping = false;
                        fish.jumpCooldown = 3.2 + Math.random() * 5.0;
                        // Cipratan air saat ikan mendarat kembali ke dalam kolam
                        createWaterRipple(fish.x + 53, fish.y + 27);
                        createSplashDroplets(fish.x + 53, fish.y + 27, 6);
                        if (fish.shadowEl) {
                            fish.shadowEl.setAttribute('cy', '36');
                            fish.shadowEl.setAttribute('rx', '34');
                            fish.shadowEl.setAttribute('fill', 'rgba(3, 105, 161, 0.28)');
                        }
                        if (fish.innerEl) {
                            fish.innerEl.style.transform = '';
                        }
                    } else {
                        const sinJump = Math.sin(jp * Math.PI);
                        jumpScale = 1 + 0.38 * sinJump;
                        jumpLiftY = -26 * sinJump;
                        // Saat melompat, ikan melaju sedikit lebih cepat
                        fish.x += fish.vx * 0.45 * sinJump * deltaTime;
                        fish.y += fish.vy * 0.45 * sinJump * deltaTime;

                        if (fish.innerEl) {
                            fish.innerEl.style.transform = `translateY(${jumpLiftY.toFixed(1)}px) scale(${jumpScale.toFixed(2)})`;
                        }
                        // Bayangan terpisah jauh di bawah air saat ikan melambung di udara
                        if (fish.shadowEl) {
                            const shadowCy = 36 + sinJump * 26;
                            const shadowRx = 34 - sinJump * 10;
                            fish.shadowEl.setAttribute('cy', shadowCy.toFixed(1));
                            fish.shadowEl.setAttribute('rx', shadowRx.toFixed(1));
                            fish.shadowEl.setAttribute('fill', `rgba(3, 105, 161, ${(0.28 - sinJump * 0.14).toFixed(2)})`);
                        }
                    }
                }

                // Smooth rotation of fish body while keeping number badge 100% upright
                if (fish.el && fish.textEl) {
                    const angleRad = Math.atan2(fish.vy, fish.vx);
                    const angleDeg = angleRad * (180 / Math.PI);
                    
                    fish.el.style.transform = `translate3d(${fish.x.toFixed(1)}px, ${fish.y.toFixed(1)}px, 0) rotate(${angleDeg.toFixed(1)}deg)`;
                    fish.textEl.style.transform = `rotate(${(-angleDeg).toFixed(1)}deg)`;
                    fish.el.style.zIndex = fish.isJumping ? '28' : '10';
                }
            });

            animationFrameId = requestAnimationFrame(gameLoop);
        }

