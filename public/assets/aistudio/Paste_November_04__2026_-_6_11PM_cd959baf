        function animateFishIntoBucket(startX, startY, palette) {
            const bucketEl = document.getElementById('bucket-wrapper');
            if (!bucketEl) return;
            const bucketRect = bucketEl.getBoundingClientRect();
            const targetX = bucketRect.left + bucketRect.width * 0.5 - 48;
            const targetY = bucketRect.top + 8;

