            if (!audioCtx || window.audioMuted) return;
            const t = audioCtx.currentTime;
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(280, t);
            osc.frequency.exponentialRampToValueAtTime(520, t + 0.08);
            osc.frequency.exponentialRampToValueAtTime(240, t + 0.16);
            gain.gain.setValueAtTime(0.08, t);
            gain.gain.exponentialRampToValueAtTime(0.004, t + 0.17);
            osc.connect(gain); gain.connect(audioCtx.destination);
            osc.start(t); osc.stop(t + 0.18);
        }

        function playCatchSound(comboCount = 1) {
            if (!audioCtx || window.audioMuted) return;
            const t = audioCtx.currentTime;
            
            // Suara percikan air (Water Splash)
            const bufferSize = audioCtx.sampleRate * 0.14;
            const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
            const data = buffer.getChannelData(0);
            for (let i = 0; i < bufferSize; i++) data[i] = Math.random() * 2 - 1;
            
            const noise = audioCtx.createBufferSource(); noise.buffer = buffer;
            const noiseFilter = audioCtx.createBiquadFilter();
            noiseFilter.type = 'bandpass'; noiseFilter.frequency.value = 950;
            const noiseGain = audioCtx.createGain();
            noiseGain.gain.setValueAtTime(0.25, t); noiseGain.gain.exponentialRampToValueAtTime(0.01, t + 0.14);
            noise.connect(noiseFilter); noiseFilter.connect(noiseGain); noiseGain.connect(audioCtx.destination);
            noise.start(t);

            // Suara Plop Air
            const plop = audioCtx.createOscillator(); const plopGain = audioCtx.createGain();
            plop.type = 'sine';
            plop.frequency.setValueAtTime(420, t); plop.frequency.exponentialRampToValueAtTime(880, t + 0.09);
            plopGain.gain.setValueAtTime(0.35, t); plopGain.gain.exponentialRampToValueAtTime(0.01, t + 0.1);
            plop.connect(plopGain); plopGain.connect(audioCtx.destination);
            plop.start(t); plop.stop(t + 0.11);

            // Chime Kemenangan (Naik nada sesuai combo)
            const pitchBoost = Math.min(comboCount - 1, 6) * 45;
            const chime = audioCtx.createOscillator(); const chimeGain = audioCtx.createGain();
            chime.type = 'triangle';
            chime.frequency.setValueAtTime(587.33 + pitchBoost, t + 0.06); 
            chime.frequency.setValueAtTime(880.00 + pitchBoost, t + 0.14);
            chimeGain.gain.setValueAtTime(0.001, t + 0.06); 
            chimeGain.gain.linearRampToValueAtTime(0.18, t + 0.1);
            chimeGain.gain.exponentialRampToValueAtTime(0.005, t + 0.38);
            chime.connect(chimeGain); chimeGain.connect(audioCtx.destination);
            chime.start(t + 0.06); chime.stop(t + 0.4);
        }

        function playLevelUpSound() {
            if (!audioCtx || window.audioMuted) return;
            const t = audioCtx.currentTime;
            const notes = [523.25, 659.25, 783.99, 1046.50];
            notes.forEach((freq, idx) => {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(freq, t + idx * 0.08);
                gain.gain.setValueAtTime(0.16, t + idx * 0.08);
                gain.gain.exponentialRampToValueAtTime(0.005, t + idx * 0.08 + 0.28);
                osc.connect(gain); gain.connect(audioCtx.destination);
                osc.start(t + idx * 0.08); osc.stop(t + idx * 0.08 + 0.3);
            });
        }

