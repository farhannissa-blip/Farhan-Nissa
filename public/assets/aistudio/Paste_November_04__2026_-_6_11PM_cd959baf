                    <circle cx="72" cy="30" r="5.5" fill="${palette.spot2}"/>
                    <circle cx="86" cy="22" r="2.8" fill="#0f172a"/>
                    <circle cx="86" cy="34" r="2.8" fill="#0f172a"/>
                </svg>
            `;
            document.body.appendChild(clone);

            // Animasi Lompatan Parabola Melengkung Tinggi ke Ember
            const duration = 620;
            const startTime = performance.now();
            const jumpPeakHeight = Math.min(220, Math.max(130, Math.abs(targetY - initY) * 0.65));

            let prevX = initX;
            let prevY = initY;

            function stepJump(now) {
                const t = Math.min(1, (now - startTime) / duration);
                // Kurva horizontal halus
                const curX = initX + (targetX - initX) * t;
                // Kurva vertikal parabola: 4 * t * (1 - t) mencapai puncak 1.0 saat t = 0.5
                const arcOffset = -4 * jumpPeakHeight * t * (1 - t);
                const curY = initY + (targetY - initY) * t + arcOffset;

                // Hitung sudut arah lompatan ikan agar kepala mengarah sesuai lintasan
                const vx = curX - prevX;
                const vy = curY - prevY;
                const angleDeg = (Math.abs(vx) + Math.abs(vy) > 0.1)
                    ? Math.atan2(vy, vx) * (180 / Math.PI)
                    : -45;

                // Efek membesar saat di puncak lompatan lalu mengecil masuk ke mulut ember
                const scale = t < 0.5
                    ? 1 + 0.45 * (t / 0.5)
                    : 1.45 - 0.95 * ((t - 0.5) / 0.5);

                clone.style.left = `${curX.toFixed(1)}px`;
                clone.style.top = `${curY.toFixed(1)}px`;
                clone.style.transform = `scale(${scale.toFixed(2)}) rotate(${angleDeg.toFixed(1)}deg)`;

                prevX = curX;
                prevY = curY;

                if (t < 1) {
                    requestAnimationFrame(stepJump);
                } else {
                    clone.remove();
                    bucketEl.classList.remove('bucket-jiggle');
                    void bucketEl.offsetWidth;
                    bucketEl.classList.add('bucket-jiggle');
                    document.getElementById('bucket-fish-tail').classList.remove('hidden');
                }
            }

            requestAnimationFrame(stepJump);
        }

