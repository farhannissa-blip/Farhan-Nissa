                            <path d="M22,28 Q45,6 82,20 Q100,28 96,28 Q100,28 82,36 Q45,50 22,28 Z" fill="${palette.body}" stroke="${palette.border}" stroke-width="1"/>
                            <!-- Koi Pattern Markings -->
                            <path d="M36,20 Q52,11 66,22 Q52,32 36,20 Z" fill="${palette.spot1}"/>
                            <circle cx="72" cy="31" r="5.5" fill="${palette.spot2}" opacity="0.85"/>
                            <!-- Eyes -->
                            <circle cx="86" cy="21.5" r="2.6" fill="#0f172a"/>
                            <circle cx="87" cy="20.8" r="0.9" fill="#ffffff"/>
                            <circle cx="86" cy="34.5" r="2.6" fill="#0f172a"/>
                            <circle cx="87" cy="33.8" r="0.9" fill="#ffffff"/>
                        </svg>
                        
                        <div class="text-group absolute flex items-center justify-center bg-white border-[2.5px] rounded-full shadow-md" style="width: 31px; height: 31px; left: 39px; top: 11.5px; border-color: ${palette.border}; transform-origin: center; z-index: 10;">
                            <span class="text-slate-950 font-black leading-none" style="font-family: 'Fredoka One', sans-serif; font-size: 14px;">${ans}</span>
                        </div>
                    </div>
                `;

                const textGroup = fishDiv.querySelector('.text-group');
                const innerEl = fishDiv.querySelector('.fish-inner');
                const shadowEl = fishDiv.querySelector('.fish-shadow');

                // Grid-based initial placement so fish don't spawn on top of each other
                const cols = 3;
                const col = idx % cols;
                const row = Math.floor(idx / cols);
                const cellW = (w - 120) / cols;
                const cellH = (h - 70) / 2;
                const startX = 15 + col * cellW + Math.random() * Math.max(10, cellW - 40);
                const startY = 15 + row * cellH + Math.random() * Math.max(10, cellH - 30);

                const angle = Math.random() * Math.PI * 2;
                const fishObj = {
                    el: fishDiv, 
                    textEl: textGroup,
                    innerEl: innerEl,
                    shadowEl: shadowEl,
                    x: startX, 
                    y: startY,
                    vx: Math.cos(angle) * baseSpeed, 
                    vy: Math.sin(angle) * baseSpeed,
                    speed: baseSpeed * (0.92 + Math.random() * 0.18),
                    wanderPhase: Math.random() * Math.PI * 2,
                    wakeTimer: Math.random() * 0.4,
                    jumpCooldown: 1.2 + idx * 1.4 + Math.random() * 2.5,
                    isJumping: false,
                    jumpTime: 0,
                    jumpDuration: 0.68,
                    palette: palette,
                    caught: false
                };

                fishDiv.onpointerdown = (e) => {
                    e.stopPropagation();
                    if (!isPlaying || isPaused || fishObj.caught) return;
                    
                    const rect = pondArea.getBoundingClientRect();
                    const localX = e.clientX - rect.left;
                    const localY = e.clientY - rect.top;

                    createWaterRipple(localX, localY);
                    createFishingNet(localX, localY, ans === currentCorrectAnswer);
                    createSplashDroplets(localX, localY, 10);
                    catchFish(ans, fishObj, e.clientX, e.clientY, localX, localY);
                };
                
                fishEntities.push(fishObj); 
                domFishContainer.appendChild(fishDiv);
            });
        }

        function catchFish(val, fishObj, clientX, clientY, localX, localY) {
            if(!isPlaying || isPaused) return;
            fishObj.caught = true;
            fishObj.el.style.pointerEvents = 'none'; 

            if(val === currentCorrectAnswer) {
                comboStreak++;
                playCatchSound(comboStreak); 

                const prevLevel = level;
                score += 10; 
                fishCaughtCount++; 
                if(fishCaughtCount % 5 === 0) {
                    level++;
                }

                // Disable other fish during transition
                fishEntities.forEach(f => { f.caught = true; f.el.style.pointerEvents = 'none'; });

                // Hide caught fish in pond and launch flying clone into bucket
                fishObj.el.style.transition = 'opacity 0.18s ease, transform 0.2s ease';
                fishObj.el.style.opacity = '0';
                animateFishIntoBucket(clientX, clientY, fishObj.palette);

                const praise = praiseWords[Math.floor(Math.random() * praiseWords.length)];
                const subPraise = comboStreak >= 2 ? `${praise} Combo x${comboStreak}` : praise;
                createFloatingFeedback(localX, localY, "+10", subPraise, true);

                updateHUD();

                if (level > prevLevel) {
                    showLevelUpBanner(level);
                }

                setTimeout(() => { 
                    if(isPlaying) nextQuestion(); 
                }, 480);
            } else { 
                // Wrong fish tapped
                fishObj.el.style.transition = 'opacity 0.25s ease';
                fishObj.el.style.opacity = '0.25';
                handleMistake(localX, localY, "SALAH IKAN!"); 
            }
        }

        function handleMistake(x, y, reasonText = "KURANG TEPAT!") {
            comboStreak = 0;
            playWrongSound(); 
            lives--; 
            updateHUD();

            createFloatingFeedback(x || pondArea.clientWidth / 2, y || pondArea.clientHeight / 2, "❌ -1 ❤️", reasonText, false);

            // Shake pond & flash red glow
            pondArea.classList.remove('shake-error');
            void pondArea.offsetWidth;
            pondArea.classList.add('shake-error');
            pondArea.style.boxShadow = 'inset 0 0 65px rgba(239,68,68,0.9), 0 10px 25px rgba(0,0,0,0.4), 0 0 0 4px #fca5a5';

            setTimeout(() => { 
                pondArea.style.boxShadow = ''; 
            }, 350);

            if(lives <= 0) { 
                setTimeout(() => gameOver(), 380); 
            } else {
                setTimeout(() => { 
                    if(isPlaying) nextQuestion(); 
                }, 450);
            }
        }

        function spawnConfetti() {
            const container = document.getElementById('confetti-container');
            if (!container) return;
            container.innerHTML = '';
            const colors = ['#fbbf24', '#38bdf8', '#f43f5e', '#34d399', '#a855f7', '#ffffff'];
            for (let i = 0; i < 36; i++) {
                const piece = document.createElement('div');
                piece.className = 'confetti-piece';
                piece.style.left = (Math.random() * 100) + '%';
                piece.style.backgroundColor = colors[i % colors.length];
                piece.style.animationDelay = (Math.random() * 0.8) + 's';
                piece.style.animationDuration = (2 + Math.random() * 1.2) + 's';
                container.appendChild(piece);
            }
        }

        function gameOver() {
            isPlaying = false; 
            stopBGM();
            if(animationFrameId) cancelAnimationFrame(animationFrameId);
            
            lastPlayedScore = score;
            lastPlayedFish = fishCaughtCount;

            document.getElementById('final-score').innerText = score;
            document.getElementById('final-fish').innerText = fishCaughtCount + " Ekor";
            document.getElementById('final-level').innerText = "Level " + level;
            document.getElementById('player-summary').innerText = `${pNama} - ${pSekolah} (Kls ${pKelas})`;
            document.getElementById('game-over-screen').classList.remove('hidden');

            spawnConfetti();
            playLevelUpSound();

            if(window.simpanSkorGlobal && score > 0) {
                window.simpanSkorGlobal(pNama, pSekolah, pKelas, score);
            }
        }

        function resetToHome() {
            document.getElementById('game-over-screen').classList.add('hidden');
            document.getElementById('game-screen').classList.remove('flex');
            document.getElementById('game-screen').classList.add('hidden');
            document.getElementById('start-screen').classList.remove('hidden');
        }

        function showLeaderboard() {
            const lbScreen = document.getElementById('leaderboard-screen');
            const lbModal = document.getElementById('leaderboard-modal');
            lbScreen.classList.remove('hidden');
            
            setTimeout(() => {
                lbScreen.classList.remove('opacity-0');
                if(lbModal) lbModal.classList.remove('scale-95');
            }, 10);

            const ul = document.getElementById('leaderboard-list');
            ul.innerHTML = '<li class="text-center text-sky-800 py-10 text-sm font-bold flex flex-col items-center justify-center h-full"><span class="animate-spin text-3xl mb-2">⏳</span>Memuat data peringkat...</li>';
            
            const myDeviceId = window.getDeviceId ? window.getDeviceId() : '';

            const banner = document.getElementById('lb-player-banner');
            if (lastPlayedScore !== null && banner) {
                document.getElementById('lb-player-name').innerText = `${pNama || 'Pemain'} - ${pSekolah || 'SDN 66 Banda Aceh'} (Kls ${pKelas || '-'})`;
                document.getElementById('lb-player-score').innerText = lastPlayedScore;
                document.getElementById('lb-player-fish').innerText = lastPlayedFish + " Ekor";
                banner.classList.remove('hidden');
            } else if (banner) {
                banner.classList.add('hidden');
            }

            if(window.pantauLeaderboard) {
                window.pantauLeaderboard((data) => {
                    if(!data || data.length === 0) { 
                        ul.innerHTML = '<li class="text-center text-sky-800 py-8 font-bold">Belum ada skor tercatat. Jadilah yang pertama!</li>'; 
                        return; 
                    }

                    ul.innerHTML = data.map((item, i) => {
                        const isMe = (item.device_id === myDeviceId);
                        const displayName = window.sanitizeName(item.nama);
                        const displaySekolah = window.sanitizeSekolah(item.sekolah);
                        const displayKelas = window.sanitizeKelas(item.kelas);

                        let rankStyle = "bg-white/90 border-2 border-sky-200/90 shadow-xs";
                        let badgeColor = "bg-sky-100 text-sky-900 border-sky-300 font-bold";
                        let rankIcon = `#${i+1}`;
                        let titleColor = "text-sky-950 font-bold";
                        let scoreColor = "text-amber-600";

                        if (i === 0) {
                            rankStyle = "bg-gradient-to-r from-amber-100 via-yellow-100 to-amber-200 border-2 border-amber-400 shadow-md";
                            badgeColor = "bg-gradient-to-r from-amber-400 to-yellow-500 text-slate-950 font-black border-amber-300 shadow-xs";
                            rankIcon = "👑 1";
                            titleColor = "text-amber-950 font-black";
                            scoreColor = "text-amber-600";
                        } else if (i === 1) {
                            rankStyle = "bg-gradient-to-r from-slate-100 via-sky-50 to-slate-200 border-2 border-slate-300 shadow-xs";
                            badgeColor = "bg-gradient-to-r from-slate-300 to-slate-400 text-slate-950 font-black border-slate-200";
                            rankIcon = "🥈 2";
                            titleColor = "text-slate-900 font-extrabold";
                            scoreColor = "text-slate-700";
                        } else if (i === 2) {
                            rankStyle = "bg-gradient-to-r from-amber-50 via-orange-100 to-amber-100 border-2 border-amber-300 shadow-xs";
                            badgeColor = "bg-gradient-to-r from-amber-500 to-orange-500 text-white font-black border-amber-400";
                            rankIcon = "🥉 3";
                            titleColor = "text-amber-900 font-extrabold";
                            scoreColor = "text-amber-700";
                        }

                        if (isMe) {
                            rankStyle += " recent-player-highlight ring-4 ring-amber-400 border-amber-500 bg-amber-50/95 z-10 relative";
                        }

                        return `
                            <li class="flex justify-between items-center p-3.5 rounded-2xl border transition ${rankStyle}">
                                <div class="flex items-center gap-3 min-w-0">
                                    <div class="px-2.5 py-1 rounded-xl text-xs font-mono border flex-shrink-0 text-center ${badgeColor}">
                                        ${rankIcon}
                                    </div>
                                    <div class="min-w-0">
                                        <div class="flex items-center gap-2">
                                            <p class="${titleColor} text-sm truncate leading-tight">${displayName}</p>
                                            ${isMe ? `<span class="bg-gradient-to-r from-amber-400 to-yellow-500 text-slate-950 text-[10px] px-2.5 py-0.5 rounded-full font-black border border-amber-300 badge-pulse flex-shrink-0 shadow-md">✨ SKOR KAMU</span>` : ''}
                                        </div>
                                        <p class="text-[11px] text-sky-700 font-semibold truncate mt-0.5">${displaySekolah} (Kls ${displayKelas})</p>
                                    </div>
                                </div>
                                <div class="text-right flex-shrink-0 ml-3">
                                    <p class="text-xs text-sky-800 uppercase font-black text-[9px]">Skor</p>
                                    <p class="text-xl title-font ${scoreColor}">${item.skor}</p>
                                </div>
                            </li>
                        `;
                    }).join('');

                    setTimeout(() => {
                        const myItem = ul.querySelector('.recent-player-highlight');
                        if (myItem) {
                            myItem.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        }
                    }, 150);
                });
            }
        }

        function closeLeaderboard() { 
            const lbScreen = document.getElementById('leaderboard-screen');
            const lbModal = document.getElementById('leaderboard-modal');
            
            lbScreen.classList.add('opacity-0');
            if(lbModal) lbModal.classList.add('scale-95');
            
            setTimeout(() => {
                lbScreen.classList.add('hidden');
            }, 300);
        }
    </script>
</body>
</html>
