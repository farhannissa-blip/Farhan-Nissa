    <script>
        let audioCtx;
        let bgmTimer = null;
        let bgmStep = 0;
        let bgmIsPlaying = false;
        let isAudioInit = false;
        window.audioMuted = false;

        // Melodi ceria bergaya Marimba Tropis
        const melodyNotes = [
            523.25, 659.25, 783.99, 1046.50, 880.00, 783.99, 659.25, 523.25,
            587.33, 698.46, 880.00, 783.99, 659.25, 587.33, 523.25, 587.33,
            523.25, 659.25, 783.99, 1046.50, 880.00, 1046.50, 783.99, 659.25,
            698.46, 783.99, 880.00, 783.99, 587.33, 659.25, 523.25, 0
        ];
        const bassNotes = [
            261.63, 0, 329.63, 0, 349.23, 0, 392.00, 0,
            293.66, 0, 392.00, 0, 261.63, 0, 392.00, 0,
            261.63, 0, 329.63, 0, 349.23, 0, 392.00, 0,
            349.23, 0, 392.00, 0, 261.63, 0, 261.63, 0
        ];

        function initAudio() {
            if (!isAudioInit) {
                try { 
                    audioCtx = new (window.AudioContext || window.webkitAudioContext)(); 
                    isAudioInit = true; 
                } catch(e) {}
            }
            if (audioCtx && audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
        }

        function playBgmStep() {
            if (!audioCtx || window.audioMuted || !bgmIsPlaying) return;
            const t = audioCtx.currentTime;
            
            const freq = melodyNotes[bgmStep % melodyNotes.length];
            if (freq > 0) {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(freq, t);
                gain.gain.setValueAtTime(0.045, t);
                gain.gain.exponentialRampToValueAtTime(0.001, t + 0.19);
                osc.connect(gain); gain.connect(audioCtx.destination);
                osc.start(t); osc.stop(t + 0.2);
            }

            const bFreq = bassNotes[bgmStep % bassNotes.length];
            if (bFreq > 0) {
                const bOsc = audioCtx.createOscillator();
                const bGain = audioCtx.createGain();
                bOsc.type = 'triangle';
                bOsc.frequency.setValueAtTime(bFreq, t);
                bGain.gain.setValueAtTime(0.035, t);
                bGain.gain.exponentialRampToValueAtTime(0.001, t + 0.22);
                bOsc.connect(bGain); bGain.connect(audioCtx.destination);
                bOsc.start(t); bOsc.stop(t + 0.24);
            }
            bgmStep++;
        }

        function startBGM() {
            if (!audioCtx || window.audioMuted || bgmIsPlaying) return;
            bgmIsPlaying = true;
            if (bgmTimer) clearInterval(bgmTimer);
            bgmTimer = setInterval(playBgmStep, 210);
        }

        function stopBGM() {
            bgmIsPlaying = false;
            if (bgmTimer) { clearInterval(bgmTimer); bgmTimer = null; }
        }

